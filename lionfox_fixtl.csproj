<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Vintage Story 1.22 runs on .NET 10; mod assemblies must match. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>$(ModAssembly)</AssemblyName>
    <RootNamespace>lionfox_fixtl</RootNamespace>
    <!-- Read from modinfo.json (Directory.Build.props), so the two can't drift: PackageMod names the zip from it,
         and two different builds sharing one version string is a real trap - it produced two distinct
         torchesheat_2.0.0.zip files on 2026-09-09 and a filename cannot tell them apart. -->
    <Version>$(ModVersion)</Version>
    <!-- The repo root IS the loadable mod folder: modinfo.json and the built DLL
         sit side by side and both are tracked. -->
    <OutputPath>../lionfox_fixtl</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ── Vintage Story install directory ──────────────────────────────────
       This used to hardcode H:\Vintagestory with NO fallback, which was right on
       SylDesk and wrong on SylG5 - the build simply failed to find the API there.
       Correcting the letter would only move the problem to the next machine, so
       the whole chain is tried: an explicit -p:VS_PATH, then the VINTAGE_STORY
       variable the launcher sets, then the usual install locations. -->
  <PropertyGroup>
    <VS_PATH Condition="'$(VS_PATH)' == ''">$(VINTAGE_STORY)</VS_PATH>
    <VS_PATH Condition="'$(VS_PATH)' == '' And Exists('$(LOCALAPPDATA)\Vintagestory\VintagestoryAPI.dll')">$(LOCALAPPDATA)\Vintagestory</VS_PATH>
    <VS_PATH Condition="'$(VS_PATH)' == '' And Exists('C:\Program Files\Vintagestory\VintagestoryAPI.dll')">C:\Program Files\Vintagestory</VS_PATH>
    <VS_PATH Condition="'$(VS_PATH)' == '' And Exists('D:\Vintagestory\VintagestoryAPI.dll')">D:\Vintagestory</VS_PATH>
    <VS_PATH Condition="'$(VS_PATH)' == '' And Exists('H:\Vintagestory\VintagestoryAPI.dll')">H:\Vintagestory</VS_PATH>
  </PropertyGroup>

  <!-- Fail loudly rather than build against a path that does not exist. -->
  <Target Name="CheckVsPath" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(VS_PATH)\VintagestoryAPI.dll')"
           Text="Could not find VintagestoryAPI.dll under VS_PATH='$(VS_PATH)'. Set the VINTAGE_STORY environment variable or build with -p:VS_PATH=&quot;C:\Path\To\Vintagestory&quot;." />
  </Target>

  <!-- DELIBERATELY the API only. This mod reaches BlockEntityTeleporterBase and
       friends by type NAME at runtime rather than referencing VSSurvivalMod, so
       it keeps loading when GameContent moves. Do not "helpfully" add a
       VSSurvivalMod reference - the self-check in StartServerSide is what makes
       that trade-off safe. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VS_PATH)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── Assemble a loadable mod folder and zip it ───────────────────────── -->
  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup>
      <ModStageDir>$(MSBuildProjectDirectory)\build\lionfoxfixtl</ModStageDir>
      <ModZipPath>$(MSBuildProjectDirectory)\build\lionfoxfixtl_$(Version).zip</ModZipPath>
    </PropertyGroup>
    <ItemGroup>
      <ModAssets Include="assets\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(ModStageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModStageDir)" />
    <Copy SourceFiles="modinfo.json" DestinationFolder="$(ModStageDir)" />
    <Copy SourceFiles="@(ModAssets)" DestinationFiles="@(ModAssets->'$(ModStageDir)\assets\%(RecursiveDir)%(Filename)%(Extension)')" Condition="'@(ModAssets)' != ''" />
    <Delete Files="$(ModZipPath)" />
    <ZipDirectory SourceDirectory="$(ModStageDir)" DestinationFile="$(ModZipPath)" />
    <Message Importance="high" Text="Packaged mod -> $(ModZipPath)" />
  </Target>

</Project>
